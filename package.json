{
  "name": "dot",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . \"**/*.{ts,tsx,js,jsx,json}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "build-eas:ios": "eas build --platform ios",
    "build-eas:android": "eas build --platform android",
    "pod": "cd ios && pod install"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.14.0",
    "@react-navigation/native": "^7.1.8",
    "date-fns": "^4.1.0",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-linear-gradient": "^55.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "lottie-react-native": "^7.3.6",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.30.0",
